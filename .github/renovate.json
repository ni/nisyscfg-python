{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "poetry"
  ],
  "poetry": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 3am on Monday"
    ]
  },
  "schedule": [
    "before 3am on Monday"
  ],
  "timezone": "UTC",
  "prConcurrentLimit": 5,
  "prCreationLimit": 2,
  "prHourlyLimit": 2,
  "rangeStrategy": "auto",
  "vulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Auto-merge patch and minor updates for Poetry dependencies",
      "matchManagers": [
        "poetry"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require manual review for major updates",
      "matchManagers": [
        "poetry"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "major-update",
        "needs-review"
      ]
    }
  ]
}
